<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fpga_udp_sensors</name>
  <version>0.0.0</version>
  <description>ROS 2 nodes for the DE0-Nano FPGA sensor streams over UDP: ADXL345 (sensor_msgs/Imu), LD19 lidar (sensor_msgs/LaserScan) and mecanum wheel-encoder odometry (nav_msgs/Odometry), with their timing</description>
  <maintainer email="manuel_lego1234@hotmail.com">xtal</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_imu_plugin</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
