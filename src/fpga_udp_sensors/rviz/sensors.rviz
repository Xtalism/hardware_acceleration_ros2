Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 24
      Alpha: 0.5
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: WheelLabels
      Enabled: true
      Namespaces:
        wheels: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /wheel_markers
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /scan
      Style: Flat Squares
      Size (m): 0.03
      Color Transformer: Intensity
      Use rainbow: true
      Autocompute Intensity Bounds: true
      Decay Time: 0
      Value: true
    - Class: rviz_imu_plugin/Imu
      Name: Imu
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /imu/data
      fixed_frame_orientation: false
      Box properties:
        Enable box: true
        x_scale: 0.10
        y_scale: 0.06
        z_scale: 0.01
        Box alpha: 0.9
      Axes properties:
        Enable axes: true
        Axes scale: 0.08
      Acceleration properties:
        Enable acceleration: true
        Derotate acceleration: true
        Acc. vector scale: 0.01
        Acc. vector alpha: 1
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Keep: 100
      Shape:
        Value: Arrow
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.02
        Color: 255; 25; 0
        Alpha: 1
      Covariance:
        Value: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Value: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 60
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.9
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: 3.6
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
